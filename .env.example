# Email for password resets (optional in development)
APP_URL=https://your-domain.co.za
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Learniverse <no-reply@your-domain.co.za>