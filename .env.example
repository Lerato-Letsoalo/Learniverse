PORT=3000
NODE_ENV=production
DB_PATH=./data/learniverse.db
ADMIN_EMAIL=admin@yourdomain.co.za
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# AI Teaching Assistant (free Groq API key from console.groq.com)
GROQ_API_KEY=KEY
